{
  "name": "sensation-theme",
  "displayName": "sensation-theme",
  "publisher": "daskopfkino",
  "repository": {
    "type": "git",
    "url": "https://github.com/laixrsales/sensation-theme.git"
  },
  "license": "MIT",
  "description": "Sensation is a theme inspired by Nestlé's Sensação chocolate. Dark mode blends brown with pink and beige accents, while light mode offers a beige base with brown and pink details. Coding never felt this smooth.",
  "version": "1.3.0",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Themes"
  ],
  "main": "./src/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "themes": [
      {
        "label": "Dark Sensation",
        "uiTheme": "vs-dark",
        "path": "./themes/sensation-dark-theme.json"
      },
      {
        "label": "Light Sensation",
        "uiTheme": "vs",
        "path": "./themes/sensation-light-theme.json"
      },
      {
        "label": "Switch Sensation",
        "uiTheme": "vs-dark",
        "path": "./themes/sensation-switch-theme.json"
      }
    ],
    "commands": [
      {
        "command": "sensation.disableAutoSwitch",
        "title": "Disable Auto Switch",
        "category": "Sensation"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Sensation",
      "properties": {
        "sensation.switch.lightTime": {
          "type": "string",
          "default": "06:00",
          "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$",
          "patternErrorMessage": "Use the 24-hour HH:MM format, e.g. 06:00.",
          "markdownDescription": "Time (24-hour `HH:MM`) when **Switch Sensation** changes to Light Sensation. Invalid values fall back to `06:00`."
        },
        "sensation.switch.darkTime": {
          "type": "string",
          "default": "18:30",
          "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$",
          "patternErrorMessage": "Use the 24-hour HH:MM format, e.g. 18:30.",
          "markdownDescription": "Time (24-hour `HH:MM`) when **Switch Sensation** changes to Dark Sensation. Invalid values fall back to `18:30`."
        }
      }
    }
  }
}
